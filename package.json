{
  "name": "gensobunya-cycle-blog",
  "homepage": "https://blog.gensobunya.net/",
  "type": "module",
  "private": true,
  "version": "3.0.0",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm astro dev",
    "dev:cf": "pnpm typegen && pnpm run build && wrangler dev --config dist/server/wrangler.json",
    "build": "pnpm typegen && pnpm astro build",
    "test": "pnpm typegen && vitest run",
    "test:light": "pnpm typegen && mkdir -p dist/client && vitest run --exclude \"**/*.credentialed.test.ts\"",
    "typecheck": "pnpm typegen && astro check",
    "lint": "oxfmt --check && oxlint",
    "lint:unused": "knip",
    "lint:fix": "oxfmt",
    "typegen": "pnpm wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@braintree/sanitize-url": "^7.1.2",
    "@cf-wasm/og": "^0.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "astro-pagefind": "^2.0.1",
    "date-fns-tz": "^3.2.0",
    "next-share": "^0.27.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satteri": "^0.11.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@tailwindcss/vite": "^4.3.5",
    "@textlint-ja/textlint-rule-no-filler": "^1.1.0",
    "@types/node": "^24.19.2",
    "knip": "^6.44.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tailwindcss": "^4.3.5",
    "textlint": "^15.8.0",
    "textlint-rule-ja-no-abusage": "^3.0.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-no-doubled-conjunction": "^3.0.1",
    "textlint-rule-no-doubled-conjunctive-particle-ga": "^3.0.0",
    "textlint-rule-no-doubled-joshi": "^5.1.1",
    "textlint-rule-no-dropping-the-ra": "^3.0.0",
    "textlint-rule-no-hankaku-kana": "^2.0.1",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-no-todo": "^2.0.1",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
