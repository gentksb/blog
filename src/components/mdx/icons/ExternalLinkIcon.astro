---
interface Props {
  width?: string
  height?: string
  class?: string
}

const {
  width = "1em",
  height = "1em",
  class: className = "inline"
} = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={width}
  height={height}
  class={className}
  aria-hidden="true"
>
  <path
    fill="currentColor"
    d="M14 3v2h3.59l-9.83 9.83l1.41 1.41L19 6.41V10h2V3m-2 16H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2z"
  ></path>
</svg>
