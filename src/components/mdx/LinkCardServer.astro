---
import { env } from "cloudflare:workers"
import { createOgpKVCacheAdapter } from "../../server/adapters/ogpAdapter"
import { getOgpMetaData } from "../../server/services/getOgpMetaData"
import { isValidUrl } from "../../server/domain/validators"
import {
  buildProductPrice,
  formatProductPrice
} from "../../server/domain/productPrice"
import {
  brandColorText,
  linkCardBadge,
  linkCardFrame,
  linkCardPrice,
  linkCardTitle
} from "./cardStyles"
import ExternalLinkIcon from "./icons/ExternalLinkIcon.astro"
import GlobeIcon from "./icons/GlobeIcon.astro"

interface Props {
  url: string
}

const { url } = Astro.props

// URLバリデーション（HTTP(S)スキームのみ許可）
if (!isValidUrl(url)) {
  throw new Error("Invalid URL: must be HTTP(S)")
}

// ブランドテーマ判定（yahoo.jpはアフィリエイト短縮URLドメイン）
const brandTheme =
  url.includes("yahoo.co.jp") || url.startsWith("https://yahoo.jp/")
    ? "yahoo"
    : url.includes("rakuten.co.jp")
      ? "rakuten"
      : null

// OGPデータ取得（KVキャッシュ付き）
let ogpTitle: string = url
let ogpDescription: string = ""
let ogpSiteName: string = ""
let ogpImageUrl: string | undefined = undefined
let priceDisplay: string | undefined = undefined

try {
  if (env.OGP_DATASTORE) {
    const cache = createOgpKVCacheAdapter(env.OGP_DATASTORE)

    // キャッシュ確認
    const cached = await cache.get(url)
    let ogpData = null

    if (cached && typeof cached === "object") {
      ogpData = cached
    } else {
      // キャッシュミス → 取得してキャッシュ保存
      ogpData = await getOgpMetaData(url, env)
      if (ogpData.ok) {
        await cache.put(url, ogpData)
      }
    }

    if (ogpData && ogpData.ok) {
      ogpTitle = ogpData.ogpTitle ?? url
      ogpDescription = ogpData.ogpDescription ?? ""
      ogpSiteName = ogpData.ogpSiteName ?? ""
      // 外部ドメインはCloudflare Image Resizingでプロキシできないため、HTTP(S)のみ許可
      ogpImageUrl = isValidUrl(ogpData.ogpImageUrl ?? "")
        ? ogpData.ogpImageUrl
        : undefined

      // 構造化データ由来の商品価格（キャッシュ済みデータはドメイン層で再検証してから使う）
      const price = buildProductPrice(
        ogpData.productPrice?.amount,
        ogpData.productPrice?.currency
      )
      if (price) {
        priceDisplay = formatProductPrice(price)
      }
    }
  }
} catch (e) {
  console.error(`LinkCard OGP fetch failed for ${url}:`, e)
}

const parsedUrl = new URL(url)
if (!ogpSiteName) {
  ogpSiteName = parsedUrl.hostname.replace(/^www\./, "")
}
const isExternal = parsedUrl.hostname !== "blog.gensobunya.net"
---

<a
  href={url}
  class="no-underline hover:opacity-90"
  target="_blank"
  rel="noopener noreferrer"
>
  <div class={linkCardFrame}>
    <div class="flex flex-1 flex-col justify-center p-3 min-w-0">
      {
        brandTheme && (
          <div class={`${linkCardBadge} ${brandColorText[brandTheme]}`}>
            {brandTheme.charAt(0).toUpperCase() + brandTheme.slice(1)}
          </div>
        )
      }
      <div class={linkCardTitle}>
        {isExternal && <ExternalLinkIcon />}
        {ogpTitle}
      </div>
      <div class="mt-1.5 line-clamp-2 text-sm font-normal text-secondary">
        {ogpDescription}
      </div>
      {
        priceDisplay && (
          <div class={`mt-1.5 ${linkCardPrice}`}>{priceDisplay}</div>
        )
      }
      <div class="mt-1.5 text-xs text-secondary">
        <GlobeIcon />
        {ogpSiteName}
      </div>
    </div>
    <div class="min-h-24 max-h-32 w-[30%] flex-shrink-0 md:max-h-40">
      {
        ogpImageUrl && (
          <figure class="h-full">
            <img
              src={ogpImageUrl}
              class="h-full w-full object-cover"
              alt="リンク先カバー画像"
              loading="lazy"
            />
          </figure>
        )
      }
    </div>
  </div>
</a>
