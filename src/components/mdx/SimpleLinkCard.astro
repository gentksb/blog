---
import ExternalLinkIcon from "./icons/ExternalLinkIcon.astro"

interface Props {
  url: string
  title?: string
}

const { url, title } = Astro.props
try {
  new URL(url)
} catch {
  throw new Error("Invalid URL")
}
---

<div
  class="not-prose my-4 rounded-md border border-stone-300 bg-white px-2 py-1 shadow-xs"
>
  <a href={url}>
    <p class="text-sm font-bold text-primary">
      <ExternalLinkIcon class="mr-1 inline" />{title ?? url}
    </p>
  </a>
</div>
