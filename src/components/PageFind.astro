---
import Search from "astro-pagefind/components/Search.astro"
---

<div class="search-container relative">
  <Search searchboxOptions={{ placeholder: "記事を検索" }} />
</div>

<style>
  /*
    astro-pagefind v2 の <pagefind-searchbox> は light DOM に .pf-* を描画し、
    その CSS は :is(*, #\#) を3重に重ねた詳細度を持つ。クラスセレクタでの上書きは
    通らないため、継承で内部へ届くカスタムプロパティだけでテーマを合わせる。
    https://pagefind.app/docs/css-variables/
  */
  .search-container {
    width: 220px;

    /* カスタムプロパティへの inherit は「親の同名変数」を指すため実フォントを渡す */
    --pf-font: var(--font-sans);
    --pf-border-radius: 0.5rem;
    --pf-text: #333;
    --pf-background: #fff;
    --pf-border: #eaeaea;
    --pf-mark: var(--color-primary);
    --pf-border-focus: var(--color-primary);
    --pf-outline-focus: var(--color-primary);
    /* 既定の 480px ではなくヘッダーの枠幅に従わせる */
    --pf-searchbox-max-width: 100%;
    --pf-searchbox-dropdown-max-height: 60vh;
  }
</style>
