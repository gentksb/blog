{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "none",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/global.css"
  },
  "astro": {},
  "associations": [
    {
      "files": ["*.md", "*.mdx"],
      "language": "markdown"
    },
    {
      "files": ["**/*.astro"],
      "language": "astro"
    }
  ],
  "ignorePatterns": [
    ".cache",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "public",
    "dist",
    "node_modules",
    "src/content/post"
  ]
}
